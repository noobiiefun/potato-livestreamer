<?xml version="1.0" encoding="utf-8"?>
<!-- FrameLayout dipilih (bukan ConstraintLayout) khusus supaya posisi
     mini-peta bisa digeser BEBAS oleh user (fitur atur posisi live-tracking).
     ConstraintLayout akan selalu menarik ulang child ke constraint yang
     didefinisikan di XML setiap kali ada layout pass, jadi manipulasi posisi
     lewat kode (drag) gampang "ketarik balik" — FrameLayout tidak begitu,
     posisi child murni dari LayoutParams (margin) yang kita atur sendiri. -->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- Kamera WAJIB paling belakang & full-screen — semua elemen lain
         (HUD, peta, chat, kontrol) adalah overlay DI ATASNYA. Ini yang
         bikin cocok untuk IRL livestreaming: apa pun posisi overlay yang
         dipilih user, penonton tetap lihat kamera penuh sebagai latar. -->
    <com.pedro.rtplibrary.view.OpenGlView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD Atas: Speedometer GPS Digital -->
    <LinearLayout
        android:id="@+id/panelHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#40000000">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/hud_speed_default"
            android:textColor="#00FF00"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/status_disconnected"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Live-Tracking: mini peta OpenStreetMap (osmdroid) — posisi + arah +
         jejak rute. Posisi default pojok kanan atas, tapi BISA DIGESER
         bebas oleh user (tekan-tahan lalu geser) — lihat setupDraggableMap()
         di MainActivity.kt. Posisi terakhir disimpan otomatis. -->
    <org.osmdroid.views.MapView
        android:id="@+id/mapView"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_gravity="top|end"
        android:layout_marginTop="110dp"
        android:layout_marginEnd="16dp"
        android:elevation="4dp" />

    <!-- Tempat Komponen Live Chat (Gunakan RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLiveChat"
        android:layout_width="280dp"
        android:layout_height="200dp"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="16dp"
        android:layout_marginBottom="96dp"
        android:background="#20000000" />

    <!-- Kontrol Panel Bawah untuk Alamat Server Streaming — POSISI TETAP,
         sengaja tidak ikut bisa digeser supaya tombol Start/Stop selalu
         gampang dijangkau & tidak ketutup elemen lain saat live. -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#90000000">

        <EditText
            android:id="@+id/etRtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/hint_rtmp_url"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp"
            android:inputType="textUri"
            android:text="@string/default_rtmp_url" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnStartStream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/btn_start_live"
                android:backgroundTint="#FF0000" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_switch_camera"
                android:backgroundTint="#333333" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnToggleMap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_toggle_map_hide"
                android:backgroundTint="#333333" />
        </LinearLayout>
    </LinearLayout>

</FrameLayout>
