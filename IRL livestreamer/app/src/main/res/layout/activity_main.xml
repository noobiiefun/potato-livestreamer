<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout 
    xmlns:android="http://android.com"
    xmlns:app="http://android.com"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <!-- View Pratinjau Kamera Khusus yang Mendukung Grafik Overlay -->
    <com.pedro.rtplibrary.view.OpenGlView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- HUD Atas: Speedometer GPS Digital -->
    <LinearLayout
        android:id="@+id/panelHud"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:background="#40000000"
        app:layout_top_toTopOf="parent">

        <TextView
            android:id="@+id/tvSpeed"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 km/h"
            android:textColor="#00FF00"
            android:textSize="46sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvStreamStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Status: Terputus"
            android:textColor="#FFFFFF"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Tempat Komponen Live Chat (Gunakan RecyclerView) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvLiveChat"
        android:layout_width="280dp"
        android:layout_height="200dp"
        android:layout_margin="16dp"
        android:background="#20000000"
        app:layout_bottom_toTopOf="@id/layoutControls"
        app:layout_leading_toLeadingOf="parent" />

    <!-- Kontrol Panel Bawah untuk Alamat Server Streaming -->
    <LinearLayout
        android:id="@+id/layoutControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp"
        android:background="#90000000"
        app:layout_bottom_toBottomOf="parent">

        <EditText
            android:id="@+id/etRtmpUrl"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Masukkan URL RTMP (rtmp://...)"
            android:textColor="#FFFFFF"
            android:textColorHint="#AAAAAA"
            android:textSize="13sp"
            android:text="rtmp://://youtube.com" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <Button
                android:id="@+id/btnStartStream"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="MULAI LIVE"
                android:backgroundTint="#FF0000" />

            <Space
                android:layout_width="12dp"
                android:layout_height="wrap_content" />

            <Button
                android:id="@+id/btnSwitchCamera"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BALIK KAMERA"
                android:backgroundTint="#333333" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
